{
  "name": "signalk-pypilot-newui",
  "version": "3.8.0",
  "description": "Signal K friendly UI for the pypilot autopilot, with first-class Signal K paths and Simple Switches so any downstream Signal K client can drive or monitor the pilot. Touch-first mobile visor + full pypilot data (servo, gains, calibration, tack, warnings). Coexists with pypilot-autopilot-provider.",
  "main": "./dist/index.js",
  "files": [
    "dist/*.js",
    "public",
    "!public/Pypilot_New_UI.png",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "signalk",
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-instruments",
    "signalk-category-utility",
    "signalk-category-ais",
    "signalk-category-notifications",
    "pypilot",
    "tinypilot",
    "autopilot",
    "steering",
    "kip",
    "mobile-first",
    "ais",
    "cpa",
    "tcpa",
    "collision-avoidance",
    "freeboard-sk-companion"
  ],
  "author": {
    "name": "Aitonos",
    "url": "https://github.com/Aitonos"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@signalk/server-api": "^2.0.0",
    "socket.io-client": "^4.7.5",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.6.0"
  },
  "signalk-plugin-enabled-by-default": true,
  "signalk": {
    "appIcon": "./public/icon-256.png",
    "displayName": "PyPilot New-UI + SK Paths",
    "webapp": "./public",
    "recommends": [
      "signalk-mareas-ihm",
      "@signalk/freeboard-sk",
      "signalk-charts-provider-simple",
      "signalk-collision-alerts",
      "signalk-polar-performance-plugin",
      "signalk-polar-management"
    ],
    "screenshots": [
      "./public/screenshots/01-control-rose.jpg",
      "./public/screenshots/05-modes-autowind.jpg",
      "./public/screenshots/02-chartplotter-embedded.jpg",
      "./public/screenshots/07-logbook-trip-detail.jpg",
      "./public/screenshots/03-anchorwatch-in-rose.jpg",
      "./public/screenshots/06-tune-sliders.jpg",
      "./public/screenshots/04-tide-popup.jpg",
      "./public/screenshots/08-tack-history.jpg"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aitonos/signalk-pypilot-newui.git"
  },
  "bugs": {
    "url": "https://github.com/Aitonos/signalk-pypilot-newui/issues"
  },
  "homepage": "https://github.com/Aitonos/signalk-pypilot-newui#readme"
}
